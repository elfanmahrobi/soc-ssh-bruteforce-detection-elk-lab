# Example only. Do not commit real passwords or API keys.
filebeat.inputs:
  - type: filestream
    id: ubuntu-auth-log
    enabled: true
    paths:
      - /var/log/auth.log
    fields:
      lab_environment: siem-soc-homelab
      log_source: ubuntu-auth
    fields_under_root: true

output.logstash:
  hosts: ["192.168.56.121:5044"]

# If TLS is enabled on the Beats input, configure the correct CA here.
# ssl.certificate_authorities: ["/etc/filebeat/certs/ca.crt"]
